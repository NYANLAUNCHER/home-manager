// ############################################################
// ###   ###  Alt-centered configuration for Zellij  ###   ####
// ############################################################
// Run `zellij setup --check` for troubleshooting and inspecting
// current config locations and features that are enabled.
theme "nord"
layout_dir ""
keybinds {
  normal clear-defaults=true {
    bind "Alt q" { Quit; }
    bind "Alt d" { Detach; }
    bind "Alt p" { SwitchToMode "pane"; }
    bind "Alt m" { SwitchToMode "move"; }
    bind "Alt r" { SwitchToMode "resize"; }
    bind "Alt t" { SwitchToMode "tab"; }
    bind "Alt s" { SwitchToMode "scroll"; }// aka search mode
    bind "Alt o" { SwitchToMode "session"; }
    // scroll buffer navigation
    bind "Ctrl Shift Up" { ScrollUp; }
    bind "Ctrl Shift Down" { ScrollDown; }
    // pane navigation
    bind "Alt h" { MoveFocus "Left"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt k" { MoveFocus "Up"; }
    bind "Alt l" { MoveFocus "Right"; }
    bind "Alt f" { ToggleFocusFullscreen; }
    bind "Alt +" { Resize "Increase"; }
    bind "Alt -" { Resize "Decrease"; }
    // spawn panes
    bind "Alt n"     { NewPane; }
    bind "Alt x"     { CloseFocus; }
    bind "Alt Left"  { NewPane "Left"; }
    bind "Alt Down"  { NewPane "Down"; }
    bind "Alt Up"    { NewPane "Up"; }
    bind "Alt Right" { NewPane "Right"; }
    // absolute tab movements
    bind "Alt 1" { GoToTab 1; }
    bind "Alt 2" { GoToTab 2; }
    bind "Alt 3" { GoToTab 3; }
    bind "Alt 4" { GoToTab 4; }
    bind "Alt 5" { GoToTab 5; }
    bind "Alt 6" { GoToTab 6; }
    bind "Alt 7" { GoToTab 7; }
    bind "Alt 8" { GoToTab 8; }
    bind "Alt 9" { GoToTab 9; }
    bind "Alt 0" { GoToTab 10; }
  }
  // Pane Mode
  pane clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "m" { SwitchToMode "move"; }
    bind "r" { SwitchToMode "resize"; }
    bind "Left"  { NewPane "Left"; }
    bind "Down"  { NewPane "Right"; }
    bind "Up"    { NewPane "Down"; }
    bind "Right" { NewPane "Up"; }
    bind "h" { MoveFocus "Left"; }
    bind "j" { MoveFocus "Down"; }
    bind "k" { MoveFocus "Up"; }
    bind "l" { MoveFocus "Right"; }
    bind "n" { NewPane; }
    bind "x" { CloseFocus; }
    bind "f" { ToggleFocusFullscreen; }
    bind "z" { TogglePaneFrames; }
  }
  // Move Mode
  move clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "h" "Left"  { MovePane "Left"; }
    bind "j" "Down"  { MovePane "Down"; }
    bind "k" "Up"    { MovePane "Up"; }
    bind "l" "Right" { MovePane "Right"; }
    bind "Alt n" { NewPane; }
    bind "Alt h" { MoveFocus "Left"; }
    bind "Alt l" { MoveFocus "Right"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt k" { MoveFocus "Up"; }
  }
  // Resize Mode
  resize clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "h" "Left"  { Resize "Left"; }
    bind "j" "Down"  { Resize "Down"; }
    bind "k" "Up"    { Resize "Up"; }
    bind "l" "Right" { Resize "Right"; }
    bind "Alt =" { Resize "Increase"; }
    bind "Alt +" { Resize "Increase"; }
    bind "Alt -" { Resize "Decrease"; }
    bind "Alt h" { MoveFocus "Left"; }
    bind "Alt l" { MoveFocus "Right"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt k" { MoveFocus "Up"; }
    bind "f" { ToggleFocusFullscreen; }
  }
  // Tab Mode
  tab clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "n" { NewTab; }
    bind "x" { CloseTab; }
    bind "s" { ToggleActiveSyncTab; }
    // relative movements
    bind "h" "Left" { GoToPreviousTab; }
    bind "l" "Right" { GoToNextTab; }
    bind "j" { MoveTab "Left"; }
    bind "k" { MoveTab "Right"; }
    // absolute movements
    bind "1" { GoToTab 1; }
    bind "2" { GoToTab 2; }
    bind "3" { GoToTab 3; }
    bind "4" { GoToTab 4; }
    bind "5" { GoToTab 5; }
    bind "6" { GoToTab 6; }
    bind "7" { GoToTab 7; }
    bind "8" { GoToTab 8; }
    bind "9" { GoToTab 9; }
    bind "0" { GoToTab 10; }
    bind "Tab" { ToggleTab; }
  }
  // Scroll/Search Mode
  scroll clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "e" { EditScrollback; SwitchToMode "normal"; }
    bind "Alt c" { ScrollToBottom; SwitchToMode "normal"; }
    bind "j" "Down" { ScrollDown; }
    bind "k" "Up" { ScrollUp; }
    bind "Alt f" "PageDown" "Right" "l" { PageScrollDown; }
    bind "Alt b" "PageUp" "Left" "h" { PageScrollUp; }
    bind "d" { HalfPageScrollDown; }
    bind "u" { HalfPageScrollUp; }
    bind "Alt h" { MoveFocus "Left"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt k" { MoveFocus "Up"; }
    bind "Alt l" { MoveFocus "Right"; }
    bind "/" "s" { SwitchToMode "entersearch"; SearchInput 0; }
  }
  search clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "/" "s" { SwitchToMode "entersearch"; SearchInput 0; }
    bind "p" { Search "Up"; }
    bind "n" { Search "Down"; }
    bind "c" { SearchToggleOption "CaseSensitivity"; }
    bind "w" { SearchToggleOption "Wrap"; }
    bind "o" { SearchToggleOption "WholeWord"; }
    bind "Alt h" { MoveFocusOrTab "Left"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt l" { MoveFocusOrTab "Right"; }
    bind "Alt k" { MoveFocus "Up"; }
  }
  entersearch clear-defaults=true {
    bind "Enter" { SwitchToMode "search"; }
    bind "Esc" { SearchInput 27; SwitchToMode "scroll"; }
    bind "Alt h" { MoveFocusOrTab "Left"; }
    bind "Alt j" { MoveFocus "Down"; }
    bind "Alt l" { MoveFocusOrTab "Right"; }
    bind "Alt k" { MoveFocus "Up"; }
  }
  // Session Mode
  session clear-defaults=true {
    bind "Enter" "Esc" { SwitchToMode "normal"; }
    bind "d" { Detach; }
    bind "w" {
      LaunchOrFocusPlugin "zellij:session-manager" {
        floating true
        move_to_focused_tab true
      };
      SwitchToMode "Normal"
    }
  }
  locked clear-defaults=true {}
  renamepane clear-defaults=true {}
  renametab clear-defaults=true {}
  tmux clear-defaults=true {}
}
// The name of the default layout to load on startup
//default_layout "compact"

// When attaching to an existing session with other users,
// should the session be mirrored (true)
// or should each user have their own cursor (false)
// Default: false
//mirror_session true

// Choose what to do when zellij receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active zellij session is closed
on_force_close "quit"
// Remove stupid pop-ups
show_startup_tips false
// Remove pane frame
pane_frames false
// On certain configurations, or terminals mouse_mode can interfere with copying text.
mouse_mode true
mouse_hover_effects true
mouse_hover_tips true
scroll_mode_sync false
// 100_000 should never exceed 6MB per shell pane, unless the lines are very long
scroll_buffer_size 100000
// Command to execute when copying text. Text will be piped to stdin of program
// to perform copy. Can be used with terminal emulators which do not support
// OSC 52 ANSI control sequence (used on default without this option).
//copy_command "xclip -selection clipboard" // x11
//copy_command "wl-copy"                    // wayland
// Choose the destination for copied text (x11/wayland only), if copy_command not set
// Options:
//   - system (default)
//   - primary
//copy_clipboard "primary"
