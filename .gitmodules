[submodule "zsh/.oh-my-zsh"]
	path = zsh/.oh-my-zsh
	url = https://github.com/ohmyzsh/ohmyzsh.git
[submodule "zsh/plugins/zsh-helix-mode"]
	path = zsh/plugins/zsh-helix-mode
	url = https://github.com/Multirious/zsh-helix-mode
[submodule "zsh/themes/powerlevel10k"]
	path = zsh/themes/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k
[submodule "vis/plugins/treeview"]
	path = vis/plugins/treeview
	url = https://github.com/stalker57241/treeview
[submodule "vis/plugins/vis-lspc"]
	path = vis/plugins/vis-lspc
	url = https://gitlab.com/muhq/vis-lspc
