#!/bin/sh
# Sourced by run.sh before starting vieb. Every value can be overridden by setting it
# in the environment first. VIEB_CONFIG_DIR is set by run.sh (the directory holding
# this file, unless overridden).
export VIEB_CONFIG_FILE="${VIEB_CONFIG_FILE:-$VIEB_CONFIG_DIR/viebrc}"
export VIEB_DATAFOLDER="${VIEB_DATAFOLDER:-${XDG_DATA_HOME:-$HOME/.local/share}/vieb}"
export VIEB_SESSIONS_DIR="${VIEB_SESSIONS_DIR:-$VIEB_DATAFOLDER/.sessions}"
export VIEB_ERWIC_DIR="${VIEB_ERWIC_DIR:-$VIEB_DATAFOLDER/erwic}"

export VIEB_DEVTOOLS_THEME="${VIEB_DEVTOOLS_THEME:-dark}"
export VIEB_AUTOPLAY_MEDIA="${VIEB_AUTOPLAY_MEDIA:-user}"
export VIEB_ACCELERATION="${VIEB_ACCELERATION:-hardware}"
